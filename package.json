{
  "name": "waitup",
  "version": "0.1.0",
  "private": true,
  "description": "Nobar dan dengerin lagu bareng. Kalau ada yang ngelag, semua nungguin.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,blue \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cross-env": "^10.1.0",
    "express": "^5.3.0",
    "jose": "^6.2.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  }
}
