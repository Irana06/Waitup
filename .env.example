# Salin jadi .env (tidak ikut ke git). Semua opsional.

# OAuth Client ID tipe Web dari Google Cloud (Google Auth Platform > Clients).
# Kosongkan untuk mematikan login Google; mode tamu tetap jalan.
GOOGLE_CLIENT_ID=

